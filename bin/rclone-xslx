#!/usr/bin/env bash
set -euo pipefail

url="${1:?usage: gsheet-xlsx GOOGLE_SHEETS_URL [output.xlsx]}"
out="${2:-$HOME/Downloads/google-sheet-$(date +%F-%H%M%S).xlsx}"

id="$(sed -E 's#.*spreadsheets/(u/[0-9]+/)?d/([^/]+).*#\2#' <<< "$url")"

if [[ -z "$id" || "$id" == "$url" ]]; then
  echo "Could not extract spreadsheet ID from URL:" >&2
  echo "$url" >&2
  exit 1
fi

mkdir -p "$(dirname "$out")"

rclone backend copyid gd: "$id" "$out" --drive-export-formats xlsx

if ! unzip -t "$out" >/dev/null 2>&1; then
  echo "Download failed or output is not a valid .xlsx:" >&2
  file "$out" >&2
  exit 1
fi

echo "$out"
