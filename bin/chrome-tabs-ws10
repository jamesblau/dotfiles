#!/usr/bin/env bash
set -euo pipefail

urls=(
  'https://mail.google.com/mail/u/0/#inbox/'
  'https://messages.google.com/web/conversations'
)

i3-msg 'workspace 10' >/dev/null

exec /usr/bin/google-chrome-stable \
  --force-device-scale-factor=2 \
  --profile-directory='Default' \
  --new-window \
  "${urls[@]}"
