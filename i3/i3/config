bindsym $mod+Control+a exec $kitty_open 'nvim ~/.local/share/clipster/history +"call ClipsterEdit()"'

# Bash history management
bindsym $mod+Control+h exec $kitty_open 'nvim ~/.my_bash_history'

# Browsers
bindsym $mod+semicolon exec --no-startup-id firefox
bindsym $mod+apostrophe exec --no-startup-id chrome
bindsym $mod+Control+apostrophe exec --no-startup-id chrome-profile1
bindsym $mod+Control+Shift+apostrophe exec --no-startup-id chatgpt

# i3 tries poorly to guess which desktop was used last
for_window [class="(?i)^(google-chrome|google-chrome-stable|chromium|chromium-browser|chrome|firefox)$"] move container to workspace current

# Firefox popups
for_window [title="Alarm - Mozilla Firefox"] floating enable,move absolute center,move workspace current

