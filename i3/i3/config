# Clipboard cleanup mode
bindsym $mod+i mode "clip: strip_whitespace"

mode "clip: strip_whitespace" {
    bindsym i exec --no-startup-id strip-whitespace; $d
    bindsym l exec --no-startup-id strip-whitespace -l; $d
    bindsym a exec --no-startup-id strip-whitespace -a; $d
    bindsym s exec --no-startup-id strip-whitespace -s; $d
    bindsym t exec --no-startup-id strip-whitespace -t; $d

    # exits
    bindsym Escape mode "default"
    bindsym Return mode "default"
    bindsym $mod+i mode "default"   # press mod+i again to cancel
}

# Kill / game controls
set $mode_kill kill/game: [f]irefox [c]hrome [b]oth [a]wake [k]ill-smash [s]mash-on [Shift+s]mash-off [w]ifi

bindsym $mod+Delete mode "$mode_kill"

mode "$mode_kill" {
    bindsym f       exec --no-startup-id kill-browsers firefox; $d
    bindsym c       exec --no-startup-id kill-browsers chrome; $d
    bindsym b       exec --no-startup-id kill-browsers all; $d

    bindsym a       exec --no-startup-id screen-awake toggle; $d

    bindsym k       exec --no-startup-id kill-smash; $d
    bindsym s       exec --no-startup-id smash-mode on; $d
    bindsym Shift+s exec --no-startup-id smash-mode off; $d

    bindsym w       exec --no-startup-id toggle-wifi; $d

    bindsym $mod+Delete $d
    bindsym Return      $d
    bindsym Escape      $d
}

